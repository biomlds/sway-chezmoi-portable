[main]
font={{ .desktop.fontMono }}:size=11
pad=10x8
term=xterm-256color

[scrollback]
lines=10000
multiplier=3.0

[cursor]
style=beam
blink=yes

[colors]
background={{ trimPrefix "#" .desktop.theme.background }}
foreground={{ trimPrefix "#" .desktop.theme.foreground }}
regular0={{ trimPrefix "#" .desktop.theme.backgroundAlt }}
regular1={{ trimPrefix "#" .desktop.theme.urgent }}
regular2={{ trimPrefix "#" .desktop.theme.accentAlt }}
regular3={{ trimPrefix "#" .desktop.theme.accent }}
regular4={{ trimPrefix "#" .desktop.theme.blue }}
regular5={{ trimPrefix "#" .desktop.theme.pink }}
regular6={{ trimPrefix "#" .desktop.theme.cyan }}
regular7={{ trimPrefix "#" .desktop.theme.foreground }}
bright0=757975
bright1=e07a7a
bright2=91c18b
bright3=f2b84b
bright4=97bad1
bright5=cd8bab
bright6=a3c8c1
bright7=e3e6e3

[mouse]
hide-when-typing=yes
