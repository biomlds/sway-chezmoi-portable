regular3=e6a76f
regular4=61afef
regular5=c678dd
regular6=79c7c5
regular7=d7dae0
bright0=5c6370
bright1=e88388
bright2=a9d18e
bright3=f0bb86
bright4=7ab7f5
bright5=d290e8
bright6=91d8d6
bright7=ffffff

[mouse]
