window { margin: 0; border: 1px solid {{ .desktop.theme.surface }}; border-radius: 6px; background-color: {{ .desktop.theme.background }}; color: {{ .desktop.theme.foreground }}; font-family: "{{ .desktop.fontSans }}"; font-size: 14px; }
#input { margin: 8px 8px 4px; padding: 6px 10px; border: 1px solid {{ .desktop.theme.surface }}; border-radius: 4px; background-color: {{ .desktop.theme.backgroundAlt }}; color: {{ .desktop.theme.foreground }}; }
*:focus { outline: none; box-shadow: none; }
#inner-box { margin: 0 8px 8px; }
#entry { padding: 6px 10px; border-radius: 4px; }
#entry:selected { background-color: {{ .desktop.theme.backgroundAlt }}; color: {{ .desktop.theme.accent }}; }
#text:selected { color: {{ .desktop.theme.accent }}; }
#img { margin-right: 8px; }
