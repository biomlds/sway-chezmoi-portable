window { margin: 0; border: 2px solid {{ .desktop.theme.accent }}; border-radius: 10px; background-color: {{ .desktop.theme.background }}; color: {{ .desktop.theme.foreground }}; font-family: "{{ .desktop.fontSans }}"; font-size: 14px; }
#input { margin: 12px; padding: 10px 12px; border: 1px solid {{ .desktop.theme.surface }}; border-radius: 7px; background-color: {{ .desktop.theme.backgroundAlt }}; color: {{ .desktop.theme.foreground }}; }
#inner-box { margin: 0 12px 12px; }
#entry { padding: 8px 10px; border-radius: 6px; }
#entry:selected { background-color: {{ .desktop.theme.surface }}; color: {{ .desktop.theme.accent }}; }
#img { margin-right: 10px; }
