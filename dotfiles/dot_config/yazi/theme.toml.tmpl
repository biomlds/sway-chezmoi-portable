# Uses the current Yazi manager UI schema; shared colors, no flavor downloads.
[mgr]
cwd = { fg = "{{ .desktop.theme.cyan }}" }
hovered = { fg = "{{ .desktop.theme.background }}", bg = "{{ .desktop.theme.accent }}", bold = true }
preview_hovered = { underline = true }
find_keyword = { fg = "{{ .desktop.theme.pink }}", bold = true }
find_position = { fg = "{{ .desktop.theme.accentAlt }}", italic = true }
marker_copied = { fg = "{{ .desktop.theme.accentAlt }}", bg = "{{ .desktop.theme.accentAlt }}" }
marker_cut = { fg = "{{ .desktop.theme.urgent }}", bg = "{{ .desktop.theme.urgent }}" }
marker_selected = { fg = "{{ .desktop.theme.accent }}", bg = "{{ .desktop.theme.accent }}" }
border_style = { fg = "{{ .desktop.theme.surface }}" }

[mode]
normal_main = { fg = "{{ .desktop.theme.background }}", bg = "{{ .desktop.theme.accent }}", bold = true }
normal_alt = { fg = "{{ .desktop.theme.accent }}", bg = "{{ .desktop.theme.backgroundAlt }}" }
select_main = { fg = "{{ .desktop.theme.background }}", bg = "{{ .desktop.theme.pink }}", bold = true }
select_alt = { fg = "{{ .desktop.theme.pink }}", bg = "{{ .desktop.theme.backgroundAlt }}" }
unset_main = { fg = "{{ .desktop.theme.background }}", bg = "{{ .desktop.theme.urgent }}", bold = true }
unset_alt = { fg = "{{ .desktop.theme.urgent }}", bg = "{{ .desktop.theme.backgroundAlt }}" }

[status]
overall = { fg = "{{ .desktop.theme.foreground }}", bg = "{{ .desktop.theme.backgroundAlt }}" }
perm_type = { fg = "{{ .desktop.theme.blue }}" }
perm_read = { fg = "{{ .desktop.theme.accentAlt }}" }
perm_write = { fg = "{{ .desktop.theme.accent }}" }
perm_exec = { fg = "{{ .desktop.theme.urgent }}" }

[filetype]
rules = [
    { name = "*/", fg = "{{ .desktop.theme.blue }}", bold = true },
    { mime = "image/*", fg = "{{ .desktop.theme.pink }}" },
    { mime = "video/*", fg = "{{ .desktop.theme.pink }}" },
    { mime = "audio/*", fg = "{{ .desktop.theme.cyan }}" },
    { mime = "application/zip", fg = "{{ .desktop.theme.accent }}" },
    { name = "*", fg = "{{ .desktop.theme.foreground }}" },
]
