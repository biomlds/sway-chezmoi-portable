#!/bin/sh
set -eu
# swayidle executes command strings through a shell. Expand HOME in that shell,
# not into an unquoted command path (home directories may contain spaces).
lock='"$HOME/.local/bin/desktop-lock"'
exec swayidle -w \
  timeout {{ .desktop.idle.lockSeconds }} "$lock" \
  timeout {{ .desktop.idle.displaySeconds }} 'swaymsg "output * power off"' \
  resume 'swaymsg "output * power on"' \
  before-sleep "$lock" \
  lock "$lock"
