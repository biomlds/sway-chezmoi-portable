#!/bin/sh
set -eu
mode=${1:-area}
dir=${XDG_SCREENSHOTS_DIR:-$HOME/Pictures/Screenshots}
mkdir -p "$dir"
file=$dir/$(date +'%Y-%m-%d_%H-%M-%S').png
case "$mode" in
    full) grim "$file" ;;
    area) geometry=$(slurp) || exit 0; [ -n "$geometry" ] || exit 0; grim -g "$geometry" "$file" ;;
    *) printf 'Usage: %s full|area\n' "$0" >&2; exit 2 ;;
esac
wl-copy --type image/png < "$file"
if command -v notify-send >/dev/null 2>&1; then notify-send 'Screenshot saved' "$file"; fi
printf '%s\n' "$file"
