#!/bin/sh
set -eu
: "${XDG_RUNTIME_DIR:?A login session with XDG_RUNTIME_DIR is required}"
umask 077
runtime=$XDG_RUNTIME_DIR/sway-desktop
mkdir -p "$runtime"
exec 9>"$runtime/session.lock"
flock -n 9 || exit 0
children=
cleanup() {
    trap - EXIT HUP INT TERM
    for child in $children; do kill "$child" 2>/dev/null || true; done
    wait 2>/dev/null || true
    rm -f "$runtime/"*.pid "$runtime/session"
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
# Owning the lock means no other supervisor is active. Never trust stale PIDs.
session=${SWAYSOCK:?Run this helper inside Sway}
rm -f "$runtime/"*.pid
printf '%s\n' "$session" > "$runtime/session"

start_component() {
    name=$1; shift
    command -v "$1" >/dev/null 2>&1 || return 0
    pidfile=$runtime/$name.pid
    # Children must not inherit the supervisor's singleton lock.
    "$@" 9>&- >"$runtime/$name.log" 2>&1 &
    children="$children $!"
    printf '%s\n' "$!" > "$pidfile"
}

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP >/dev/null 2>&1 || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP >/dev/null 2>&1 || true
fi
start_component notifications mako
start_component waybar waybar
if [ "${1:-}" = --clipboard ]; then
    start_component clipboard "$HOME/.local/bin/desktop-clipboard-watch"
fi
start_component idle "$HOME/.local/bin/desktop-idle"
start_component polkit "$HOME/.local/bin/desktop-polkit-agent"
start_component network nm-applet --indicator
if command -v blueman-applet >/dev/null 2>&1; then start_component bluetooth blueman-applet; fi
# Stay alive until this compositor exits, then reap the daemons we launched.
# An IPC disconnect also returns, so a crashed compositor is handled.
swaymsg -m -t subscribe '["shutdown"]' 9>&- >/dev/null 2>&1 || true
